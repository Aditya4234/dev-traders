# ⚠️ IMPORTANT: Never commit real secrets to this file
# Copy this to .env.local and fill in your values

# MongoDB (use localhost for local dev, Atlas for production)
MONGODB_URI=mongodb://localhost:27017/riya_touch

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# JWT - Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-random-64-byte-hex-string
JWT_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Notifications
NOTIFICATION_PROVIDER=web3forms
ADMIN_EMAIL=admin@example.com
ADMIN_WHATSAPP=
FRONTEND_URL=http://localhost:3000
WEB3FORMS_ACCESS_KEY=
SMTP_EMAIL=
SMTP_APP_PASSWORD=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CALLMEBOT_API_KEY=
MSG91_API_KEY=
MSG91_FLOW_ID=
ORDER_WEBHOOK_URL=

# Frontend Public
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Business Info
BUSINESS_STATE=Rajasthan

# Grafana
GRAFANA_PASSWORD=change-this

# Elasticsearch Security (docker-compose)
ES_SECURITY_ENABLED=true
ELASTIC_PASSWORD=changeme
